# VERONIX Environment Configuration Template
# Copy this to .env in your project root and customize values

# ==============================================================================
# OLLAMA CONFIGURATION
# ==============================================================================
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDER=nomic-embed-text

# ==============================================================================
# VOICE/TTS CONFIGURATION
# ==============================================================================
# Available voices: en-US-AriaNeural, en-US-GuyNeural, en-US-JennyNeural, etc.
TTS_VOICE=en-US-AriaNeural
# Rate: -50% to +50%
TTS_RATE=+0%
# Volume: -100% to +100%
TTS_VOLUME=+0%

# ==============================================================================
# UI CONFIGURATION
# ==============================================================================
UI_WIDTH=1400
UI_HEIGHT=900
ENABLE_HIGH_DPI=true

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# MEMORY CONFIGURATION
# ==============================================================================
MEMORY_USER_ID=boss
MEMORY_SAVE_ERRORS=true

# ==============================================================================
# PATHS (Optional - auto-detected if not set)
# ==============================================================================
# PROJECT_ROOT will be auto-detected from config.py location
# BRAIN_DATA_DIR will default to {PROJECT_ROOT}/Brain_Data
# KNOWLEDGE_BASE_DIR will default to {PROJECT_ROOT}/Knowledge_Base
# MODELS_DIR will default to {PROJECT_ROOT}/Models
